# ==============================================================================
# SwitchOps — Environment Configuration Template (.env.example)
# Copy this file to '.env' and fill in your keys. NEVER commit '.env' to git!
# ==============================================================================

# --- Switch Agent Protocol Server Configuration ---
SWITCHOPS_SERVER_HOST=127.0.0.1
SWITCHOPS_SERVER_PORT=8765
SWITCHOPS_ENVIRONMENT=production

# --- Switch Room Bridges (Slack / Discord / Teams) ---
# Paste your webhook URLs or bridge tokens into .env only (gitignored)
SLACK_INCIDENT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
DISCORD_INCIDENT_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK/ID
TEAMS_INCIDENT_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR/WEBHOOK/URL

# --- AI Provider API Keys (Claude Code / OpenAI / Anthropic) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# --- Wispr Flow Integration ---
WISPR_FLOW_API_KEY=your_wispr_flow_api_key_here
WISPR_FLOW_MODE=realtime_dictation

# --- Observability & Telemetry Integrations ---
DATADOG_API_KEY=your_datadog_api_key_here
DATADOG_APP_KEY=your_datadog_app_key_here
SENTRY_DSN=https://your_sentry_dsn_here@sentry.io/project
KUBERNETES_CLUSTER_ENDPOINT=https://k8s-prod.internal.yourcompany.com
