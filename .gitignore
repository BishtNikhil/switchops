.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.id_rsa*
*.pub
id_rsa
secrets/
credentials/
auth/
*.token
*.secret

# --- Python Intermediates & Caches ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Intermediate Render & Processing Caches & Media > 100MB ---
*.mp4
*.m4a
*.wav
Myvoiceover/
processed_audio/
processed_audio_*/
temp_*.mp4
temp_*.wav
*.tmp
*.temp
check_timing.py
convert_raw.py
inspect_audio_energy.py
parse_timings.py
val_*.png
test_*.png
video_caption_sample_*.png
